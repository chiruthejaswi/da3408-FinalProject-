# Reproducible training/data environment (same pins as MLproject's conda.yaml).
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && git config --global --add safe.directory /work
# The repository is bind-mounted at /work by docker-compose (keeps .git and .dvc available).
CMD ["dvc", "repro"]
